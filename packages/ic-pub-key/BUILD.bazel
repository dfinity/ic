load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test", "rust_test_suite")

package(default_visibility = ["//visibility:public"])

FEATURES = [
    "secp256k1",
    "secp256r1",
    "ed25519",
    "vetkeys",
]

rust_library(
    name = "ic-pub-key",
    srcs = glob(["src/**/*.rs"]),
    crate_features = FEATURES,
    crate_name = "ic_pub_key",
    version = "0.4.0",
    deps = [
        "//packages/ic-ed25519",
        "//packages/ic-secp256k1",
        "//packages/ic-secp256r1",
        "@crate_index//:ic-cdk-management-canister",
        "@crate_index//:ic-management-canister-types",
        "@crate_index//:ic-vetkeys",
    ],
)

# Once https://github.com/bazelbuild/rules_rust/pull/3544 is part of a release
# and we are using the respective rules_rust version, we can use the new
# crate_features rather than the rustdoc_flags.
rust_doc(
    name = "doc",
    crate = ":ic-pub-key",
    rustdoc_flags = ["--cfg=feature=\"%s\"" % feature for feature in FEATURES],
)

rust_doc_test(
    name = "doc_test",
    crate = ":ic-pub-key",
    crate_features = FEATURES,
    deps = [":ic-pub-key"],
)

rust_test(
    name = "unit_tests",
    crate = ":ic-pub-key",
    crate_features = FEATURES,
)

rust_test_suite(
    name = "integration_tests",
    srcs = glob(["tests/**/*.rs"]),
    crate_features = FEATURES,
    deps = [
        ":ic-pub-key",
        "@crate_index//:hex",
    ],
)
