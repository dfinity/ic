{
  "image": "ghcr.io/dfinity/ic-dev@sha256:3e028a468490dddda2b255da986c8ea2fe9c2dd2a143d4557c9bd5bb68c8218a",
  "remoteUser": "ubuntu",
  "privileged": true,
  "runArgs": [
    "--hostname",
    "devenv-container",
    "--network",
    "host",
    "--cgroupns",
    "host",
    "--add-host",
    "devenv-container:127.0.0.1",
    // expected by ic-os build (same as ci/container/container-run.sh and the CI
    // workflows); declared here rather than in "mounts" because the
    // devcontainer mount schema only covers bind & volume mounts.
    "--mount",
    "type=tmpfs,target=/tmp/containers"
  ],
  // Mount the checkout at the same absolute path it has on the host and use it
  // as the working directory, like ci/container/container-run.sh does: host
  // paths stay valid inside the container and bazel derives a per-checkout
  // output base from the workspace path.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "initializeCommand": "mkdir -p ~/.aws ~/.ssh ~/.cache/cargo ~/.claude ~/.local/share/fish /tmp/ict_testnets && touch ~/.zsh_history ~/.bash_history",
  // Runs once per container creation, inside the container. The checkout is
  // mounted at its host path, so bazel's default output base (md5 of that
  // path) would be the one ci/container/container-run.sh containers use for
  // the same checkout; bazel cannot see a server that runs in another
  // container (separate PID namespaces) and the two would kill each other's
  // server. Pin a devcontainer-specific output base via the container-local
  // ~/.bazelrc (not a host file; a rebuild recreates it). The install base and
  // the repository cache stay shared under the same output_user_root.
  // Lifecycle commands run from the workspace folder; the output base is derived
  // from $PWD (not from an interpolated path) and init.sh is given in array form
  // so that a checkout path with spaces or quotes cannot break them.
  "postCreateCommand": "echo \"startup --output_base=$HOME/.cache/bazel/_bazel_$(id -un)/devcontainer-$(printf %s \"$PWD\" | md5sum | cut -c1-32)\" > ~/.bazelrc",
  "postStartCommand": ["${containerWorkspaceFolder}/ci/container/init.sh"],
  "containerEnv": {
    "CARGO_TARGET_DIR": "/home/ubuntu/.cache/cargo",
    "HOSTUSER": "${localEnv:USER}",
    "LANG": "C.UTF-8",
    // Same as ci/container/container-run.sh: the checkout's .git/worktrees/*
    // entries point at host paths of other worktrees that are not mounted here,
    // so git considers them prunable and `git gc --auto` could prune them from
    // the host after gc.worktreePruneExpire (default: 3 months).
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "gc.worktreePruneExpire",
    "GIT_CONFIG_VALUE_0": "never"
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.cache",
      "target": "/home/ubuntu/.cache",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.ssh",
      "target": "/home/ubuntu/.ssh",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.aws",
      "target": "/home/ubuntu/.aws",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.claude",
      "target": "/home/ubuntu/.claude",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.bash_history",
      "target": "/home/ubuntu/.bash_history",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.zsh_history",
      "target": "/home/ubuntu/.zsh_history",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.local/share/fish",
      "target": "/home/ubuntu/.local/share/fish",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "bazelbuild.vscode-bazel",
        "stackbuild.bazel-stack-vscode",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        // Exclude bazel output directories (bazel-bin, bazel-out, bazel-testlogs
        // and the bazel-<checkout directory name> symlink) from search
        "search.exclude": {
          "bazel-*/": true,
          "targets/": true
        },
        // rust-analyzer runs `cargo` with RUSTUP_AUTO_INSTALL=0, so a freshly
        // (re)built dev container that lacks the toolchain pinned in
        // rust-toolchain.toml fails to load the workspace until it's installed
        // by hand. Overriding it back to 1 lets rust-analyzer's own cargo
        // invocation install the pinned toolchain on demand. extraEnv is
        // applied after rust-analyzer sets the =0 default, so this wins.
        "rust-analyzer.cargo.extraEnv": {
          "RUSTUP_AUTO_INSTALL": "1"
        },
        "rust-analyzer.check.extraEnv": {
          "RUSTUP_AUTO_INSTALL": "1"
        }
      }
    }
  }
}
