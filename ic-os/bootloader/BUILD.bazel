load("//toolchains/sysimage:toolchain.bzl", "vfat_image")

package(default_visibility = ["//rs:ic-os-pkg"])

exports_files([
    "grubenv",
    "guestos_grub.cfg",
    "hostos_grub.cfg",
    "setupos_grub.cfg",
    "guestos_boot_args.template",
    "hostos_boot_args.template",
    "setupos_boot_args.template",
])

genrule(
    name = "build-bootloader-tree",
    srcs = [
        "context/docker-base",
    ],
    outs = [
        "bootloader-tree.tar",
    ],
    # Run under proc_wrapper like the other ic-os build steps: it sets up (and
    # tears down) the temporary directories this script builds in, and pre-warms
    # podman's SHM lock segment so this action cannot race concurrent ic-os
    # actions to create it.
    cmd = "$(location //toolchains/sysimage:proc_wrapper) " +
          "$(location build-bootloader-tree.sh) -b $< -o $@",
    # Bazel doesn't forward the "requires-network" tag to the Remote Execution API (REAPI)
    # so we need this Namespace.so-specific execution property to open up the network on RBE:
    exec_properties = {"namespace_requires_network": "true"},
    tags = [
        "manual",
        "requires-network",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    tools = [
        "build-bootloader-tree.sh",
        "//toolchains/sysimage:proc_wrapper",
    ],
)

vfat_image(
    name = "partition-esp.tzst",
    src = ":bootloader-tree.tar",
    partition_size = "100M",
    subdir = "boot/efi",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
)
