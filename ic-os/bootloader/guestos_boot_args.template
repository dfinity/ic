# Kernel cmdline parameters for launching the GuestOS.
# BOOT_ARGS_A targets partition set "A" while BOOT_ARGS_B targets partition set "B"
#
# To run system with SELinux in PERMISSIVE mode, change enforcing=1 to enforcing=0:
# the system will use SELinux and keep track of operations that would
# be prohibited, but will only log but not actually deny them. This is
# useful for debug and policy development.
#
# oops=panic panic=10: turn any kernel Oops into a panic and reboot 10 s later.
# softlockup_panic=1 watchdog_thresh=60: also panic when a CPU is stuck in the kernel for 120 s
# (twice watchdog_thresh). The default 20 s is too short: a vCPU starved by an oversubscribed host
# looks stuck as well. The window cannot be longer: a stuck CPU reports an RCU stall itself every
# 180 s (3 x rcupdate.rcu_cpu_stall_timeout) and that report restarts the soft-lockup window.
#
# lsm=: the security modules to enable, in this order, instead of the kernel's CONFIG_LSM list.
BOOT_ARGS_A="root=/dev/disk/by-partuuid/7c0a626e-e5ea-e543-b5c5-300eb8304db7 console=ttyS0 nomodeset oops=panic panic=10 softlockup_panic=1 watchdog_thresh=60 dfinity.system=A lsm=lockdown,capability,landlock,yama,selinux,ima,evm selinux=1 enforcing=1 root_hash=ROOT_HASH"
BOOT_ARGS_B="root=/dev/disk/by-partuuid/a78bc3a8-376c-054a-96e7-3904b915d0c5 console=ttyS0 nomodeset oops=panic panic=10 softlockup_panic=1 watchdog_thresh=60 dfinity.system=B lsm=lockdown,capability,landlock,yama,selinux,ima,evm selinux=1 enforcing=1 root_hash=ROOT_HASH"
BOOT_ARGS_TEE_A="root=/dev/disk/by-partuuid/7c0a626e-e5ea-e543-b5c5-300eb8304db7 console=ttyS0 nomodeset oops=panic panic=10 softlockup_panic=1 watchdog_thresh=60 dfinity.system=A dfinity.tee=1 lsm=lockdown,capability,landlock,yama,selinux,ima,evm selinux=1 enforcing=1 root_hash=ROOT_HASH"
BOOT_ARGS_TEE_B="root=/dev/disk/by-partuuid/a78bc3a8-376c-054a-96e7-3904b915d0c5 console=ttyS0 nomodeset oops=panic panic=10 softlockup_panic=1 watchdog_thresh=60 dfinity.system=B dfinity.tee=1 lsm=lockdown,capability,landlock,yama,selinux,ima,evm selinux=1 enforcing=1 root_hash=ROOT_HASH"
