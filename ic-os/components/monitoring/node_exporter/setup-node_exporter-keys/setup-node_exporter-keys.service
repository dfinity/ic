[Unit]
Description=Generate node_exporter TLS key pair on first boot
RequiresMountsFor=/boot/config
# In GuestOS with TEE, the key pair is kept in the encrypted store, if mounted.
After=var-lib-ic-data.mount
# bootstrap-ic-node.service may chown the store recursively to ic-replica.
After=bootstrap-ic-node.service
# The GuestOS scripts read the VM type that init-config.service records.
After=init-config.service
# setup-permissions.service relabels /var/lib/ic/data, which fails if a key
# directory is created or removed meanwhile.
Before=setup-permissions.service
Before=node_exporter.service

[Install]
WantedBy=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/opt/ic/bin/setup-node_exporter-keys.sh
