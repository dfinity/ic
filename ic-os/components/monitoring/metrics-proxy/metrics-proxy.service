[Unit]
Description=Prometheus metrics proxy
After=node_exporter.service network-online.target
Wants=network-online.target

[Service]
User=metrics-proxy
ExecStart=/opt/ic/bin/metrics-proxy /etc/metrics-proxy.yaml
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
