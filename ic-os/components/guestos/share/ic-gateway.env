# Policy only. The engine's own values -- base domains, the DNS provider API and
# the ACME account -- come from its operator canister and are injected by the
# orchestrator, which does not start ic-gateway without them.
LISTEN_PLAIN=[::]:80
LISTEN_TLS=[::]:443
METRICS_LISTEN=[::]:9314
IC_URL=http://127.0.0.1:8080
ACME_CHALLENGE=dns
ACME_WILDCARD=true
ACME_DNS_BACKEND=ic_dns_lb
# not needed for engines where the gateway only serves the local engine
DISABLE_ROUTING_TABLE_FETCHER=true
LOG_JOURNALD=true
LOG_LEVEL=debug
