[Unit]
Description=Upgrade Proxy
After=network-online.target
Wants=network-online.target
Before=guestos.target
StartLimitIntervalSec=300s
StartLimitBurst=30

[Service]
Type=exec
User=upgrade-proxy
Group=upgrade-proxy
StateDirectory=ic/upgrade-proxy ic/upgrade-proxy/tmp

NoNewPrivileges=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

ExecStartPre=/usr/sbin/nginx -t -c /etc/nginx/upgrade-proxy.conf -g 'daemon off;'
ExecStart=/usr/sbin/nginx -c /etc/nginx/upgrade-proxy.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -t -c /etc/nginx/upgrade-proxy.conf -g 'daemon off;'
ExecReload=/bin/kill -HUP $MAINPID

KillSignal=SIGQUIT
KillMode=mixed
TimeoutStopSec=30s
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
WantedBy=guestos.target
