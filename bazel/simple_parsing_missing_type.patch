index d38126d..c22d4d1 100644
--- a/simple_parsing/helpers/hparams/hparam.py
+++ b/simple_parsing/helpers/hparams/hparam.py
@@ -61,7 +61,7 @@ def uniform(
     min: Union[int, float],
     max: Union[int, float],
     discrete: bool = None,
-    default: Union[int, float, dataclasses._MISSING_TYPE] = dataclasses.MISSING,
+    default: Union[int, float, type(dataclasses.MISSING)] = dataclasses.MISSING,
     strict: bool = False,
     shape: Union[int, Tuple[int, ...]] = None,
     **kwargs,
@@ -170,7 +170,7 @@ def log_uniform(
     min: Union[int, float],
     max: Union[int, float],
     discrete: bool = False,
-    default: Union[int, float, dataclasses._MISSING_TYPE] = dataclasses.MISSING,
+    default: Union[int, float, type(dataclasses.MISSING)] = dataclasses.MISSING,
     shape: Union[int, Tuple[int, ...]] = None,
     **kwargs,
 ) -> Union[int, float]:
@@ -206,7 +206,7 @@ loguniform = log_uniform
 @wraps(_choice)
 def categorical(
     *choices: T,
-    default: Union[T, dataclasses._MISSING_TYPE] = dataclasses.MISSING,
+    default: Union[T, type(dataclasses.MISSING)] = dataclasses.MISSING,
     probabilities: Union[List[float], Dict[str, float]] = None,
     strict: bool = False,
     **kwargs: Any,
