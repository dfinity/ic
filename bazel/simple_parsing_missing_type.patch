# simple-parsing imports dataclasses._MISSING_TYPE, the class of dataclasses.MISSING. Python 3.15 made
# dataclasses.MISSING a sentinel (PEP 661) and removed that class, so importing simple_parsing fails with
#   ImportError: cannot import name '_MISSING_TYPE' from 'dataclasses'
# This patch puts type(dataclasses.MISSING) in its place in type annotations. On Python 3.14 and older, that is the
# class simple-parsing imported. On 3.15 it is the builtin class sentinel, which all sentinels share
# (dataclasses.KW_ONLY too), so field()'s one isinstance() check becomes an identity check with MISSING.
# simple-parsing's latest release (0.1.9) and its main branch still import dataclasses._MISSING_TYPE: drop this
# patch once a release supports Python 3.15.
diff --git a/simple_parsing/helpers/fields.py b/simple_parsing/helpers/fields.py
index a200808..9862e00 100644
--- a/simple_parsing/helpers/fields.py
+++ b/simple_parsing/helpers/fields.py
@@ -6,7 +6,7 @@ import functools
 import inspect
 import warnings
 from collections import OrderedDict
-from dataclasses import _MISSING_TYPE, MISSING
+from dataclasses import MISSING
 from enum import Enum
 from logging import getLogger
 from typing import Any, Callable, Hashable, Iterable, TypeVar, overload
@@ -24,6 +24,10 @@ from .subgroups import subgroups  # noqa: F401
 
 logger = getLogger(__name__)
 
+# The type of dataclasses.MISSING. Python 3.15 made dataclasses.MISSING a sentinel (PEP 661) and removed
+# its class dataclasses._MISSING_TYPE.
+_MISSING_TYPE = type(MISSING)
+
 E = TypeVar("E", bound=Enum)
 K = TypeVar("K", bound=Hashable)
 V = TypeVar("V")
@@ -145,7 +149,7 @@ def field(
             compare=compare,
             metadata=_metadata,
         )
-    elif not isinstance(default_factory, dataclasses._MISSING_TYPE):
+    elif default_factory is not MISSING:
         return dataclasses.field(
             default_factory=default_factory,
             init=init,
