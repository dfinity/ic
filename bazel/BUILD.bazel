load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("//bazel:cc_headers_dir.bzl", "cc_headers_dir")
load("//bazel:defs.bzl", "volatile_status", "write_stable_status_file_var")

bool_flag(
    name = "enable_malicious_code",
    build_setting_default = False,
)

config_setting(
    name = "malicious_code_enabled",
    flag_values = {
        ":enable_malicious_code": "True",
    },
)

bool_flag(
    name = "enable_fuzzing_code",
    build_setting_default = False,
)

config_setting(
    name = "fuzzing_code_enabled",
    flag_values = {
        ":enable_fuzzing_code": "True",
    },
)

# Flag to enable uploading performance system test results to the ES database
# that is connected to the testnet Grafana dashboard.
bool_flag(
    name = "enable_upload_perf_systest_results",
    build_setting_default = False,
)

config_setting(
    name = "upload_perf_systest_results_enabled",
    flag_values = {
        ":enable_upload_perf_systest_results": "True",
    },
)

# Allow targets to opt out of hermetic toolchains, in favor of the one provided
# by the system
bool_flag(
    name = "hermetic_cc",
    build_setting_default = True,
)

config_setting(
    name = "use_hermetic_cc",
    flag_values = {
        ":hermetic_cc": "True",
    },
)

# The hermetic toolchain's libunwind headers, exposed as a directory for the
# cc-rs-compiled C code in //rs/canister_sandbox (which does
# `#include <libunwind.h>`). zig cc shipped these headers in its default
# include path; hermetic-llvm's zero-sysroot clang does not.
cc_headers_dir(
    name = "libunwind_include",
    strip_prefix = "libunwind/include/",
    visibility = ["//visibility:public"],
    deps = ["@llvm-project//libunwind:headers"],
)

# Hermetic-llvm toolchains, wrapped so that they are additionally gated on
# :use_hermetic_cc (see the bool_flag above). With --hermetic_cc=false none of
# these match and toolchain resolution falls through to the autodetected local
# toolchain registered by rules_cc (@local_config_cc_toolchains), which
# respects action_env CC/CXX/LD — needed by --config=afl.
# See: https://github.com/dfinity/ic/pull/3508
#
# These mirror the toolchains hermetic-llvm generates in @llvm_toolchains
# (same constraints and target_settings, same underlying cc_toolchain); only
# the :use_hermetic_cc gate is added.
[
    toolchain(
        name = "hermetic_cc_%s_%s_to_%s_%s" % (exec_os, exec_cpu, target_os, target_cpu),
        exec_compatible_with = [
            "@platforms//os:" + exec_os,
            "@platforms//cpu:" + exec_cpu,
        ],
        target_compatible_with = [
            "@platforms//os:" + target_os,
            "@platforms//cpu:" + target_cpu,
        ],
        target_settings = [
            ":use_hermetic_cc",
            "@llvm//toolchain:bootstrap_stage0_prebuilt_seed",
        ],
        toolchain = "@llvm_toolchains//:%s_%s_cc_toolchain" % (exec_os, exec_cpu),
        toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    )
    for (exec_os, exec_cpu, target_os, target_cpu) in [
        # Linux executors: native + cross + wasm.
        ("linux", "x86_64", "linux", "x86_64"),
        ("linux", "x86_64", "linux", "aarch64"),
        ("linux", "x86_64", "none", "wasm32"),
        ("linux", "aarch64", "linux", "aarch64"),
        ("linux", "aarch64", "linux", "x86_64"),
        ("linux", "aarch64", "none", "wasm32"),
        # macOS executors: wasm only; native macOS targets use the system
        # Xcode toolchain (see MODULE.bazel).
        ("macos", "x86_64", "none", "wasm32"),
        ("macos", "aarch64", "none", "wasm32"),
    ]
]

string_flag(
    name = "timeout_value",
    build_setting_default = "10m",
    visibility = ["//visibility:public"],
)

write_stable_status_file_var(
    name = "version.txt",
    varname = "STABLE_VERSION",
    visibility = ["//visibility:public"],
)

write_stable_status_file_var(
    name = "commit_date_iso_8601.txt",
    varname = "STABLE_COMMIT_DATE_ISO_8601",
    visibility = ["//visibility:public"],
)

# This is the contents of the ctx.version_file,
# i.e. all non-STABLE_, volatile key value pairs outputted from ./workspace_status.sh.
#
# Targets that need to use volatile keys should depend on this directly.
# When volatile keys change the target remains cached.
# When the target has to be rebuilt it will always use the latest volatile keys.
volatile_status(
    name = "volatile-status.txt",
    visibility = ["//visibility:public"],
)

# Prebuilt protoc binary, selected by exec platform.
# Used instead of @protobuf//:protoc to avoid
# compiling protoc from C++ source on every build.
# Platform config_settings are defined in //:BUILD.bazel alongside platform() rules.
# Inspired by: https://github.com/protocolbuffers/protobuf/issues/19558
alias(
    name = "protoc",
    actual = select({
        "@bazel_tools//src/conditions:linux_x86_64": "@toolchains_protoc_hub.linux_x86_64//:bin/protoc",
        "@bazel_tools//src/conditions:linux_aarch64": "@toolchains_protoc_hub.linux_aarch_64//:bin/protoc",
        "@bazel_tools//src/conditions:darwin_x86_64": "@toolchains_protoc_hub.osx_x86_64//:bin/protoc",
        "@bazel_tools//src/conditions:darwin_arm64": "@toolchains_protoc_hub.osx_aarch_64//:bin/protoc",
    }),
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "prost_generator.sh",
        "generic_rust_bench.sh",
        "canbench.sh",
        "check_endpoints_test.sh",
        "file_size_test.sh",
        "pkg_config_no_link_metadata.sh",
    ],
    visibility = ["//visibility:public"],
)

BUILDIFIER_EXCLUDES = [
    "./.git/*",
]

buildifier(
    name = "buildifier",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "fix",
    mode = "fix",
    visibility = ["//visibility:public"],
)

buildifier(
    name = "buildifier.check",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    mode = "diff",
    visibility = ["//visibility:public"],
)
