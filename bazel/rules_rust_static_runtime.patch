-        runtime_libs = cc_toolchain.dynamic_runtime_lib(feature_configuration = feature_configuration)
+        # For shared libraries we prefer the static C++ runtime when the
+        # toolchain provides one (`static_runtime_lib`), falling back to the
+        # dynamic runtime (e.g. the system libstdc++.so with local
+        # toolchains, which provide no static runtime). Hermetic toolchains
+        # like hermetic-llvm only usably ship a static runtime, and its
+        # libunwind is the sole provider of the `_Unwind_*` symbols rust std
+        # needs since the toolchain links with `--unwindlib=none`; their
