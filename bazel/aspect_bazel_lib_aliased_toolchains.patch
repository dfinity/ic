# aspect_bazel_lib turned five of its toolchain types into aliases of the
# toolchain types of the modules it now wraps: tar became an alias of tar.bzl's
# in 2.21.1 (https://github.com/bazel-contrib/bazel-lib/pull/1153), and
# copy_directory, copy_to_directory, coreutils and expand_template became
# aliases of bazel_lib's in 2.22.0
# (https://github.com/bazel-contrib/bazel-lib/pull/1216). It still registers
# its own toolchains for them, though. aspect_bazel_lib is a direct dependency
# of the root module, so these registrations come before bazel_lib's and
# tar.bzl's and win for every rule that requests one of the shared types:
# - hermetic-llvm's toolchain setup (bazel_lib's copy_file and
#   copy_to_directory) would run aspect_bazel_lib's own builds of these tools,
#   e.g. an older uutils coreutils. With bazel_lib >= 3.8.0 in the graph
#   copy_to_directory fails outright: bazel_lib's rule then passes its
#   arguments in a params file, which aspect_bazel_lib's binary doesn't accept
#   (https://github.com/bazel-contrib/bazel-lib/issues/1312).
# - tar.bzl's tar (e.g. //rs/tests:sh and :awk) would run aspect_bazel_lib's
#   expand_template and bsdtar instead of bazel_lib's and tar.bzl's.
# Without these registrations each shared type resolves to the toolchains of
# the module that defines it. jq, yq, zstd and bats are still aspect_bazel_lib's
# own toolchain types, so their registrations stay.
# Upstream's fix for bazel-lib issue 1312 on its 2.x branch
# (https://github.com/bazel-contrib/bazel-lib/pull/1313, not in a release yet)
# removes only the copy_directory, copy_to_directory and coreutils
# registrations.
# TODO: once a release has that fix, reduce this patch to the expand_template
# and bsd_tar registrations. Drop it once a release registers none of the five.
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -37,14 +37,9 @@
 use_repo(bazel_lib_toolchains, "bats_toolchains", "bsd_tar_toolchains", "copy_directory_toolchains", "copy_to_directory_toolchains", "coreutils_toolchains", "expand_template_toolchains", "jq", "jq_toolchains", "yq", "yq_toolchains", "zstd_toolchains")
 
 register_toolchains(
-    "@copy_directory_toolchains//:all",
-    "@copy_to_directory_toolchains//:all",
     "@jq_toolchains//:all",
     "@yq_toolchains//:all",
-    "@coreutils_toolchains//:all",
-    "@expand_template_toolchains//:all",
     "@bats_toolchains//:all",
-    "@bsd_tar_toolchains//:all",
     "@zstd_toolchains//:all",
 )
 
