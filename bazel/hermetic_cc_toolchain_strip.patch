+// Runs the intended zig process to completion and then strips the debug info
+// off its output, for build determinism.
+fn spawnAndStrip(arena: mem.Allocator, io: Io, params: ExecParams) u8 {
+    // Build a strip command. Use an absolute path: this wrapper also runs at
+    // rustdoc doc-test time where the environment is cleared (no PATH), so a
+    // bare "strip" would fail to resolve with error.FileNotFound.
+    const strip_bin = for ([_][]const u8{ "/usr/bin/strip", "/bin/strip" }) |p| {
+        Dir.accessAbsolute(io, p, .{}) catch continue;
+        break p;
+    } else return fatal("strip binary not found (checked /usr/bin/strip and /bin/strip)\n", .{});
+
+    const strip_cmd = blk: {
+        var list: ArrayListUnmanaged([]const u8) = .empty;
+        list.appendSlice(arena, &[_][]const u8{ strip_bin, "-S" }) catch |err| {
+            return fatal("error building strip cmd: {s}\n", .{@errorName(err)});
+        };
+
+        // Find any output targets
+        var next = false;
+        for (params.args.items) |param| {
+            if (mem.eql(u8, param, "-o")) {
+                next = true;
+            } else if (next) {
+                list.append(arena, param) catch |err| {
+                    return fatal("error adding output target: {s}\n", .{@errorName(err)});
+                };
+                break;
+            }
+        }
+        break :blk list;
+    };
+
+    // Run the intended zig process
+    const code = spawnAndWait(io, params);
+
+    // Run strip command, ignore output
+    var strip_proc = process.spawn(io, .{
+        .argv = strip_cmd.items,
         .environ_map = params.env,
-    });
-    std.debug.print(
-        "error execing {s}: {s}\n",
-        .{ params.args.items[0], @errorName(err) },
-    );
-    return 1;
+        .stdout = .ignore,
+        .stderr = .ignore,
+    }) catch |err| {
+        return fatal("running strip: {s}\n", .{@errorName(err)});
+    };
+
+    _ = strip_proc.wait(io) catch |err| {
+        return fatal("waiting for strip: {s}\n", .{@errorName(err)});
+    };
+
+    return code;
 }
 
