-fn replaceProcess(io: Io, params: ExecParams) u8 {
-    const err = process.replace(io, .{
-        .argv = params.args.items,
+// Runs the intended zig process to completion and then strips the debug info
+// off its output, for build determinism.
+fn spawnAndStrip(io: Io, params: ExecParams) u8 {
+    // The output is the argument following "-o". Invocations without one
+    // (e.g. `zig ar`, or a compiler feature test writing to stdout) have
+    // nothing to strip, so they just run zig.
+    const output = blk: {
+        var next = false;
+        for (params.args.items) |param| {
+            if (mem.eql(u8, param, "-o")) {
+                next = true;
+            } else if (next) {
+                break :blk param;
+            }
+        }
+        break :blk null;
+    } orelse return spawnAndWait(io, params);
+
+    // Use an absolute path for strip: this wrapper also runs at rustdoc
+    // doc-test time where the environment is cleared (no PATH), so a bare
+    // "strip" would fail to resolve with error.FileNotFound.
+    const strip_bin = for ([_][]const u8{ "/usr/bin/strip", "/bin/strip" }) |p| {
+        Dir.accessAbsolute(io, p, .{}) catch continue;
+        break p;
+    } else return fatal("strip binary not found (checked /usr/bin/strip and /bin/strip)\n", .{});
+
+    // Run the intended zig process
+    const code = spawnAndWait(io, params);
+
+    // Strip the debug info off the output, ignoring strip's output and exit
+    // status: stripping is a best-effort determinism measure, and there are
+    // legitimate cases where it cannot do anything. The output may not exist
+    // (zig itself failed, which `code` already reports), or it may not be a
+    // file this strip understands (e.g. the .wasm the wasm32 targets emit).
+    // Neither should turn a successful zig invocation into a failed action.
+    var strip_proc = process.spawn(io, .{
+        .argv = &[_][]const u8{ strip_bin, "-S", output },
         .environ_map = params.env,
-    });
-    std.debug.print(
-        "error execing {s}: {s}\n",
-        .{ params.args.items[0], @errorName(err) },
-    );
-    return 1;
+        .stdout = .ignore,
+        .stderr = .ignore,
+    }) catch |err| {
+        return fatal("running strip: {s}\n", .{@errorName(err)});
+    };
+
+    _ = strip_proc.wait(io) catch |err| {
+        return fatal("waiting for strip: {s}\n", .{@errorName(err)});
+    };
+
+    return code;
 }
 
