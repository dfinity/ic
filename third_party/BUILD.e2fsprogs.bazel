"""
e2fsprogs, built from source. The bundled libuuid/libblkid are enabled so we
don't link against system copies.
"""

load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

configure_make(
    name = "e2fsprogs_impl",
    args = ["-j"],
    configure_in_place = True,
    configure_options = [
        # Use the bundled libuuid/libblkid rather than the host's, so the binary
        # stays self-contained.
        "--enable-libuuid",
        "--enable-libblkid",
        "--enable-fuse2fs",
        # Trim optional features that would pull in extra deps or shared libs.
        "--disable-uuidd",
        "--disable-nls",
        "--disable-tls",
        "--disable-fsck",
        # Link e2fsprogs' own libraries (libext2fs, libcom_err, ...) into the
        # binaries statically, so they don't need a shared lib alongside them.
        "--disable-elf-shlibs",
        # The e2scrub install rules write to absolute host paths (/usr/lib/udev,
        # /etc/cron.d, /usr/lib/systemd) which fails under the build sandbox.
        # Disable each by pointing them at "no".
        "--with-udev-rules-dir=no",
        "--with-crond-dir=no",
        "--with-systemd-unit-dir=no",
    ],
    # No -static here. zig has no static glibc to offer ("error: libc of the
    # specified target requires dynamic linking"), and linking the *host's*
    # libc.a is exactly what we want to get away from: it baked the build
    # container's glibc into these binaries without being part of Bazel's action
    # key, so one remote cache entry outlived every container image bump and
    # broke the build-determinism check. Linked against zig's glibc 2.31 stubs
    # the binaries end up requiring only glibc >= 2.28 at runtime, and they are
    # build-time tools; dosfstools and mtools are built the same way.
    env = {
        "CFLAGS": "-O2 -I$$EXT_BUILD_DEPS/include",
        "LDFLAGS": "-L$$EXT_BUILD_DEPS/lib",
    },
    lib_source = ":all_srcs",
    out_binaries = [
        "fuse2fs",
        "mke2fs",
    ],
    # We don't ship any libs out of this build; everything is folded into the
    # exported binaries.
    out_shared_libs = [],
    out_static_libs = [],
    # mke2fs is installed under sbin/ by autotools (it's a sysadmin tool);
    # rules_foreign_cc only picks up out_binaries from bin/, so move it.
    #
    # Then drop the rest of the install tree (unused & non-reproducible).
    # The headers under include/ are kept since rules_foreign_cc declares them
    # as an output.
    postfix_script = (
        "mkdir -p $$INSTALLDIR/bin" +
        " && cp $$INSTALLDIR/sbin/mke2fs $$INSTALLDIR/bin/mke2fs" +
        " && find $$INSTALLDIR -mindepth 1 -maxdepth 1 ! -name bin ! -name include -exec rm -rf {} +" +
        " && find $$INSTALLDIR/bin -mindepth 1 ! -name fuse2fs ! -name mke2fs -delete"
    ),
    # The zig toolchains we register only cover linux; and the tools are only
    # ever used to build Linux filesystem images anyway.
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "@libfuse",
    ],
)

filegroup(
    name = "fuse2fs",
    srcs = [":e2fsprogs_impl"],
    output_group = "fuse2fs",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "mke2fs",
    srcs = [":e2fsprogs_impl"],
    output_group = "mke2fs",
    visibility = ["//visibility:public"],
)
