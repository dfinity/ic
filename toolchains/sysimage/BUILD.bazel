load("@python_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load(":base_images.bzl", "ICOS_BASE_IMAGES")
load(":toolchain.bzl", "oci_rootfs")

package(default_visibility = ["//visibility:public"])

# The base images, flattened into root filesystem tars, e.g.
# :icos_base_guestos_prod_rootfs. See base_images.bzl.
[
    oci_rootfs(
        name = name + "_rootfs",
        layout = "@{0}_linux_amd64//:{0}_linux_amd64".format(name),
        tags = ["manual"],
        target_compatible_with = ["@platforms//os:linux"],
    )
    for name in ICOS_BASE_IMAGES
]

# The kernel the container build VMs boot: the GuestOS base image's. It has
# virtio-blk and ext4 built in, so it needs no initramfs.
genrule(
    name = "build_vm_kernel",
    srcs = [":icos_base_guestos_prod_rootfs"],
    outs = ["build_vm_vmlinuz"],
    cmd = """
set -euo pipefail
for f in $(SRCS); do case "$$f" in *.tar) rootfs="$$f";; esac; done
kernels=$$(tar -tf "$$rootfs" | grep -E '^boot/vmlinuz-[^/]+$$')
[ "$$(echo "$$kernels" | wc -l)" -eq 1 ] || { echo "expected one kernel, got: $$kernels" >&2; exit 1; }
tar -xOf "$$rootfs" "$$kernels" > $@
""",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

# Process wrapper for the ic-os build commands that run podman (the local-base-*
# base images).
sh_binary(
    name = "proc_wrapper",
    srcs = ["proc_wrapper.sh"],
)

# Process wrapper for all other ic-os build commands. They need no privileges,
# so they can run sandboxed and remotely.
sh_binary(
    name = "tmpdir_wrapper",
    srcs = ["tmpdir_wrapper.sh"],
)

