load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel:defs.bzl", "rust_ic_bench")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "nns_delegation_reader",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "ic_nns_delegation_reader",
    deps = [
        # Keep sorted.
        "//rs/crypto/tree_hash",
        "//rs/monitoring/logger",
        "//rs/registry/routing_table",
        "//rs/types/types",
        "@crate_index//:serde",
        "@crate_index//:serde_cbor",
        "@crate_index//:slog",
        "@crate_index//:tokio",
    ],
)

rust_test(
    name = "nns_delegation_reader_test",
    crate = ":nns_delegation_reader",
    deps = [
        # Keep sorted.
        "//rs/canonical_state",
        "//rs/certification",
        "//rs/http_endpoints/nns_delegation_reader/test_utils",
        "//rs/test_utilities/types",
        "@crate_index//:assert_matches",
        "@crate_index//:rstest",
    ],
)

rust_ic_bench(
    name = "nns_delegation_reader_bench",
    testonly = True,
    srcs = ["benches/nns_delegation_reader.rs"],
    deps = [
        # Keep sorted.
        ":nns_delegation_reader",
        "//rs/crypto/tree_hash",
        "//rs/http_endpoints/nns_delegation_reader/test_utils",
        "//rs/monitoring/logger",
        "//rs/registry/routing_table",
        "//rs/test_utilities/types",
        "//rs/types/types",
        "@crate_index//:criterion",
        "@crate_index//:pprof",
        "@crate_index//:serde_cbor",
        "@crate_index//:tokio",
    ],
)
