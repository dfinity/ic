load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

DEPENDENCIES = [
    # Keep sorted.
    "//rs/types/base_types",
    "//rs/types/types",
    "@crate_index//:futures",
    "@crate_index//:prometheus-parse",
    "@crate_index//:reqwest",
    "@crate_index//:strum",
    "@crate_index//:tokio",
]

DEPENDENCIES_MACROS = [
    # Keep sorted.
    "@crate_index//:strum_macros",
]

rust_library(
    name = "subnet_merging",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "ic_subnet_merging",
    proc_macro_deps = DEPENDENCIES_MACROS,
    version = "0.1.0",
    visibility = ["//rs:system-tests-pkg"],
    deps = DEPENDENCIES,
)

rust_test(
    name = "subnet_merging_test",
    crate = ":subnet_merging",
    proc_macro_deps = DEPENDENCIES_MACROS,
    deps = DEPENDENCIES,
)
