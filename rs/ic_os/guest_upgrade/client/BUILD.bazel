load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//rs:ic-os-pkg"])

rust_binary(
    name = "client",
    srcs = ["src/main.rs"],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    deps = [
        ":lib",
        "//rs/crypto/utils/threshold_sig_der",
        "//rs/ic_os/config/tool:config_lib",
        "//rs/ic_os/config/types:config_types",
        "//rs/ic_os/guest_upgrade/shared",
        "//rs/ic_os/os_tools/guest_disk:guest_disk_lib",
        "//rs/ic_os/sev/attestation",
        "//rs/ic_os/sev/guest",
        "//rs/protobuf",
        "//rs/registry/keys",
        "//rs/registry/nns_data_provider",
        "//rs/registry/transport",
        "//rs/types/types",
        "@crate_index//:anyhow",
        "@crate_index//:der",
        "@crate_index//:http",
        "@crate_index//:hyper-rustls",
        "@crate_index//:hyper-util",
        "@crate_index//:prost",
        "@crate_index//:rcgen",
        "@crate_index//:rustls",
        "@crate_index//:sev",
        "@crate_index//:tempfile",
        "@crate_index//:tokio",
        "@crate_index//:tonic",
        "@crate_index//:tower",
        "@crate_index//:url",
        "@crate_index//:x509-parser",
    ],
)

rust_binary(
    name = "client_dev",
    srcs = ["src/main.rs"],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    deps = [
        ":lib",
        "//rs/crypto/utils/threshold_sig_der",
        "//rs/ic_os/config/tool:config_lib_dev",
        "//rs/ic_os/config/types:config_types",
        "//rs/ic_os/guest_upgrade/shared",
        "//rs/ic_os/os_tools/guest_disk:guest_disk_lib",
        "//rs/ic_os/sev/attestation",
        "//rs/ic_os/sev/guest",
        "//rs/protobuf",
        "//rs/registry/keys",
        "//rs/registry/nns_data_provider",
        "//rs/registry/transport",
        "//rs/types/types",
        "@crate_index//:anyhow",
        "@crate_index//:der",
        "@crate_index//:http",
        "@crate_index//:hyper-rustls",
        "@crate_index//:hyper-util",
        "@crate_index//:prost",
        "@crate_index//:rcgen",
        "@crate_index//:rustls",
        "@crate_index//:sev",
        "@crate_index//:tempfile",
        "@crate_index//:tokio",
        "@crate_index//:tonic",
        "@crate_index//:tower",
        "@crate_index//:url",
        "@crate_index//:x509-parser",
    ],
)

rust_library(
    name = "lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "guest_upgrade_client",
    proc_macro_deps = [
        "@crate_index//:async-trait",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    deps = [
        "//rs/crypto/utils/threshold_sig_der",
        "//rs/ic_os/config/types:config_types",
        "//rs/ic_os/guest_upgrade/shared",
        "//rs/ic_os/os_tools/guest_disk:guest_disk_lib",
        "//rs/ic_os/sev/attestation",
        "//rs/ic_os/sev/guest",
        "//rs/protobuf",
        "//rs/registry/keys",
        "//rs/registry/nns_data_provider",
        "//rs/registry/transport",
        "//rs/types/types",
        "@crate_index//:anyhow",
        "@crate_index//:der",
        "@crate_index//:http",
        "@crate_index//:hyper-rustls",
        "@crate_index//:hyper-util",
        "@crate_index//:mockall",
        "@crate_index//:prost",
        "@crate_index//:rcgen",
        "@crate_index//:rustls",
        "@crate_index//:sev",
        "@crate_index//:tempfile",
        "@crate_index//:tokio",
        "@crate_index//:tonic",
        "@crate_index//:tower",
        "@crate_index//:url",
        "@crate_index//:x509-parser",
    ],
)

rust_test(
    name = "lib_test",
    crate = ":lib",
)
