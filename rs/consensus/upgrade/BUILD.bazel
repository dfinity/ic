load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "upgrade",
    srcs = glob(["src/**/*.rs"]),
    crate_features = select({
        "//conditions:default": [],
    }),
    crate_name = "ic_consensus_upgrade",
    proc_macro_deps = [
        # Keep sorted.
    ],
    version = "0.9.0",
    deps = [
        # Keep sorted.
        "//rs/interfaces",
        "//rs/types/types",
    ],
)

rust_doc(
    name = "consensus_upgrade_doc",
    crate = ":upgrade",
)

rust_test(
    name = "upgrade_test",
    crate = ":upgrade",
    deps = [
        # Keep sorted.
        "//rs/types/types_test_utils",
    ],
)
