load("@rules_rust//rust:defs.bzl", "rust_library")
load("//rs/tests:system_tests.bzl", "oci_tar", "uvm_config_image")

package(default_visibility = ["//rs:system-tests-pkg"])

exports_files([
    "universal_vm_activation.sh",
])

rust_library(
    name = "canister_http",
    testonly = True,
    srcs = ["canister_http.rs"],
    crate_name = "canister_http",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        # Keep sorted.
        "//rs/config",
        "//rs/cycles_account_manager",
        "//rs/https_outcalls/pricing",
        "//rs/protobuf",
        "//rs/registry/subnet_features",
        "//rs/registry/subnet_type",
        "//rs/replicated_state",
        "//rs/rust_canisters/canister_test",
        "//rs/rust_canisters/proxy_canister:lib",
        "//rs/test_utilities/types",
        "//rs/tests/driver:ic-system-test-driver",
        "//rs/types/cycles",
        "//rs/types/management_canister_types",
        "//rs/types/types",
        "@crate_index//:anyhow",
        "@crate_index//:candid",
        "@crate_index//:rand",
        "@crate_index//:serde",
        "@crate_index//:slog",
        "@crate_index//:tokio",
    ],
)

oci_tar(
    name = "minica.tar",
    image = "@minica",
    repo_tags = ["minica:image"],
)

uvm_config_image(
    name = "http_uvm_config_image",
    srcmap = {
        ":minica.tar": "minica.tar",
        ":universal_vm_activation.sh": "activate",
        "//ic-os/components:networking/dev-certs/canister_http_test_ca.cert": "cert.pem",
        "//ic-os/components:networking/dev-certs/canister_http_test_ca.key": "key.pem",
        "//rs/tests/httpbin-rs:httpbin.tar": "httpbin.tar",
    },
    tags = ["manual"],  # this target will be built if required as a dependency of another target
)
