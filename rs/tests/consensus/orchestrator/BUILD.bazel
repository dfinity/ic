system_test_nns(
    name = "standard_engine_replica_version_test",
    # 1 API BN + 1 System + 2 * 4 Cloud Engine = 10 IC Node VMs * 6 vCPUs.
    cpus = MIN_LOCAL_CPUS + 10 * DEFAULT_VCPUS_PER_VM,
    # This is needed so that the test can elect a second Guestos/Replica version.
    guestos_update = "test",
    tags = [
        "long_test",  # since it takes longer than 5 minutes.
    ],
    # Time out after 1 hour, because 15 minutes is not enough. Just to give
    # an idea of why this takes so long, we need 2 engines to show that
    # the fleet can be mixed. Each has a minimum of 4 nodes. Multiple rounds
    # of upgrading take place. Each node upgrade requires downloading a VM
    # image, and VM images are fairly large.
    test_timeout = "eternal",
    deps = [
        # Keep sorted.
        "//rs/canister_client",
        "//rs/engine_controller:ic_engine_controller",
        "//rs/nervous_system/common/test_keys",
        "//rs/nns/common",
        "//rs/nns/constants",
        "//rs/protobuf",
        "//rs/registry/canister",
        "//rs/registry/helpers",
        "//rs/registry/subnet_type",
        "//rs/rust_canisters/canister_test",
        "//rs/rust_canisters/dfn_candid",
        "//rs/tests/consensus/upgrade:common",
        "//rs/tests/consensus/utils",
        "//rs/tests/driver:ic-system-test-driver",
        "//rs/types/base_types",
        "//rs/types/types",
        "@crate_index//:anyhow",
        "@crate_index//:candid",
        "@crate_index//:futures",
        "@crate_index//:slog",
    ],
)

